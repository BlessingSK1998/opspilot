# --- Database -------------------------------------------------------------
# SQLAlchemy URL (psycopg 3 driver). docker compose overrides host to "postgres".
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot

# --- API ------------------------------------------------------------------
# Shared secret for the X-API-Key header. CHANGE for any non-local deployment.
OPSPILOT_API_KEY=dev-key
# Where the dashboard finds the API.
OPSPILOT_API_URL=http://127.0.0.1:8000

# --- LLM ------------------------------------------------------------------
# Leave empty to run fully offline with the deterministic mock provider.
OPENAI_API_KEY=
# Model used when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=4

# --- Personal profile ---------------------------------------------------
# Name used to sign draft replies for personal-inbox e-mails (optional).
OPSPILOT_OWNER_NAME=

# --- Mailbox sync (read-only IMAP) -----------------------------------------
# Connects to YOUR mailbox and sends new mail through the pipeline. It never deletes, moves,
# flags or marks anything as read. For Gmail: turn on 2-step verification, then create an
# "app password" (Google Account > Security > App passwords). Never use your normal password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# ops (Northwind operations inbox) or personal (job search, finances, accounts, people)
IMAP_PROFILE=personal
# On the first run only mail from the last N days is fetched.
IMAP_SINCE_DAYS=14
# Upper bound per sync run, and seconds between runs in --watch mode.
IMAP_MAX_PER_RUN=50
SYNC_INTERVAL_SECONDS=120
# Where the last-seen message id is remembered.
SYNC_STATE_PATH=.opspilot-sync.json

# --- Integrations (all optional) -------------------------------------------
# If set, notify_human also posts to this Slack incoming webhook.
SLACK_WEBHOOK_URL=
# Set to true (plus LANGSMITH_API_KEY) to enable LangSmith tracing.
LANGSMITH_TRACING=false

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
